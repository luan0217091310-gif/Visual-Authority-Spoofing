# Virtual environments
.venv/
venv/
ENV/

# Python cache
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/

# Secrets & environment variables
.env
.env.*
*.pem
*.key

# OS / Editor files
.DS_Store
Thumbs.db
